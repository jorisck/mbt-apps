{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "app/admin/static/admin.css"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "openapi": {
      "outputs": ["packages/api-client/openapi.json", "packages/api-client/src/schema.d.ts"]
    }
  }
}
