# --- Runtime ---
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Hôtes (routage par Host, voir spec §3.2) ---
# En local, *.localhost résout vers 127.0.0.1 sans configuration.
ADMIN_HOST=gestion.localhost
PUBLIC_API_HOST=api.localhost
# URL publique de l'admin pour les liens des e-mails (déduite de ADMIN_HOST si vide)
ADMIN_BASE_URL=

# --- Liens affichés dans l'espace de gestion ---
# Bouton « En savoir plus sur HandyCab » (page de connexion)
HANDYCAB_URL=https://www.handycab.be
# Pied de page « Un service proposé par MBT Taxis »
MBTTAXIS_URL=https://www.mbttaxis.be

# --- Base de données (PostgreSQL local ; Heroku Postgres en prod) ---
# Heroku fournit postgres://..., l'application le réécrit en postgresql+asyncpg://
DATABASE_URL=postgresql://localhost:5432/mbt_dev
TEST_DATABASE_URL=postgresql://localhost:5432/mbt_test

# --- Secrets (générer des valeurs aléatoires, ne jamais committer) ---
# Clés AES-256-GCM versionnées : k2:<32 octets base64>,k1:<32 octets base64>
# La première chiffre, toutes peuvent déchiffrer. Générer : python -m app.cli gen-key
APP_ENCRYPTION_KEYS=
# Signature des jetons d'accès des clients (JWT HS256), 32 octets minimum
SECRET_KEY=
# Ancienne clé acceptée en vérification pendant une rotation
SECRET_KEY_PREVIOUS=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Clés des sites (X-Client-Key) : site_mbt:<clé>,site_handycab:<clé> ---
BFF_KEYS=

# --- E-mails (Resend) ---
# Sans clé, les e-mails sont écrits dans les logs en développement
RESEND_API_KEY=
RESEND_FROM_EMAIL=MBT Taxis <noreply@notifications.mbttaxis.be>
# Valeur initiale de company.notification_emails (séparées par des virgules)
ADMIN_NOTIFY_EMAILS=

# --- Google Maps / Places (clé serveur : validation des adresses) ---
GOOGLE_MAPS_API_KEY=
# [Option] signature des URL de carte statique de l'admin
GOOGLE_MAPS_STATIC_SIGNING_SECRET=

# --- Supervision ---
SENTRY_DSN=

# --- Webhooks (livrés avec le lot L4) ---
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOWED_PORTS=443
QUOTAGUARDSTATIC_URL=
