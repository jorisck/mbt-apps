# --- Runtime ---
APP_ENV=development
# Origins autorisés (sites marketing, admin, mobile)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Base de données (Heroku Postgres en prod) ---
DATABASE_URL=postgres://user:password@localhost:5432/mbt

# --- Auth ---
# Secret pour signer JWT / sessions (générer une valeur longue aléatoire)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- E-mails (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=MBT Taxis <noreply@mbttaxis.be>
# Destinataires des nouvelles demandes (séparés par des virgules) — surchargé ensuite par l’admin
ADMIN_NOTIFY_EMAILS=ops@mbttaxis.be

# --- Google Maps / Places (côté serveur : géocodage, validation d’adresse) ---
GOOGLE_MAPS_API_KEY=

# --- Webhooks (Taxiger / destinations) ---
# Secret HMAC par défaut pour signer les payloads (peut être surchargé par destination)
WEBHOOK_HMAC_SECRET=change-me-webhook-secret
