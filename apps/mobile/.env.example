# --- API ---
# URL de l'API publique (en local : http://api.localhost:8000)
EXPO_PUBLIC_API_URL=http://api.localhost:8000

# --- Google Places (autocomplétion d'adresse) ---
# Clé restreinte à l'identifiant de l'application (bundle iOS, paquet Android + empreinte)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Le numéro de téléphone public est lu via GET /v1/config (aucune valeur en dur ici)
